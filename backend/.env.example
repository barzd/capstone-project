# Copy this file to backend/.env and fill in real values. Never commit .env.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.e9ga7jk.mongodb.net/
DJANGO_SECRET_KEY=generate-one-with-the-command-in-the-README
# Add your computer's LAN IP when testing from a phone, e.g.
# ALLOWED_HOSTS=localhost,127.0.0.1,192.168.1.25
# CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://192.168.1.25:5173

# Optional: Google sign-in (see backend/GOOGLE_OAUTH_SETUP.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: real password-reset emails (see backend/FORGOT_PASSWORD_SETUP.md)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
