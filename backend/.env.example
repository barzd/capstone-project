# Copy this file to backend/.env and fill in real values. Never commit .env.
MONGODB_URI=mongodb+srv://YOUR_USERNAME:YOUR_PASSWORD@cluster0.e9ga7jk.mongodb.net/
DJANGO_SECRET_KEY=generate-one-with-the-command-in-the-README

# Optional: Google sign-in (see backend/GOOGLE_OAUTH_SETUP.md)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Optional: real password-reset emails (see backend/FORGOT_PASSWORD_SETUP.md)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
